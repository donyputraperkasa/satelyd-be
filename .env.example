# Database PostgreSQL (Supabase / Railway / Self-hosted)
DATABASE_URL=postgresql://user:password@host:5432/satelyd?schema=public
DIRECT_URL=postgresql://user:password@host:5432/satelyd?schema=public

# Auth & Security
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Server & Network
PORT=4000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Game & Token System
GAME_TOKEN_PRICE=1000
EXAM_CREDIT_PRICE=1000
TOKEN_PRICE=1000
FREE_GAME_QUESTION_LIMIT=10

# Services / WhatsApp Redirect
WHATSAPP_PHONE=6281234567890

# Owner Account Initial Seed
OWNER_NAME="Admin Satelyd"
OWNER_EMAIL="admin@satelyd.com"
OWNER_PASSWORD="SecurePassword123!"
